@model List<PhotoAlbum.Models.AlbumSection>
@{
    ViewData["Title"] = "Photo Album";
}

<!-- ── Hero ── -->
<section class="home-hero" id="home-hero">
    <div class="home-hero-bg"></div>
    <div class="home-hero-content">
        <div class="home-hero-icon animate-float">📷</div>
        <h1 class="home-hero-title">Photo Album</h1>
        <p class="home-hero-subtitle">A personal collection of life's most meaningful moments — pick an album below to explore.</p>
        <div class="hero-divider"></div>
    </div>
    <div class="hero-scroll-hint">
        <span>Choose an album</span>
        <div class="scroll-arrow">↓</div>
    </div>
</section>

<!-- ── Album Cards ── -->
<section class="albums-section" id="albums-section" aria-label="Album list">
    <div class="albums-grid">
        @for (int i = 0; i < Model.Count; i++)
        {
            var album = Model[i];
            var delay = i * 100;
            <a class="album-card" id="album-card-@(i+1)"
               asp-controller="Album" asp-action="@album.Route"
               style="animation-delay: @(delay)ms"
               aria-label="Open @album.Name album">
                <div class="album-card-img-wrap">
                    <img src="@album.CoverImage" alt="@album.Name cover" class="album-card-img" loading="lazy" />
                    <div class="album-card-overlay"></div>
                    <div class="album-card-icon">@album.Icon</div>
                </div>
                <div class="album-card-body">
                    <h2 class="album-card-title">@album.Name</h2>
                    <p class="album-card-desc">@album.Description</p>
                    <span class="album-card-cta">View Album <span class="cta-arrow">→</span></span>
                </div>
            </a>
        }
    </div>
</section>
